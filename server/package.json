{
  "name": "circuitiq-api",
  "version": "0.3.0",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --watch --env-file=.env dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/unit.test.cjs",
    "test:integration": "npm run build && node --test test/integration.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "12.2.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
