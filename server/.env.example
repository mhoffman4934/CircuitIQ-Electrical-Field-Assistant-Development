# Server only. Never copy database or Admin SDK credentials into the mobile app.
DATABASE_URL=postgresql://circuitiq:circuitiq_local@localhost:5432/circuitiq
FIREBASE_PROJECT_ID=your-existing-firebase-project-id
# Absolute path to a Firebase Admin service account JSON stored OUTSIDE this repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
PORT=3000
# Optional comma-separated web origins. Native mobile clients do not need CORS.
CORS_ORIGINS=http://localhost:8081
